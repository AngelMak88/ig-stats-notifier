# RapidAPI key subscribed to "Instagram Looter2"
# (https://rapidapi.com/irrors-apis/api/instagram-looter2) — a separate
# subscription from the "instagram-scraper-stable-api" key used by
# reel-research-tool, even if it's the same RapidAPI account.
RAPIDAPI_KEY=

# Telegram bot (see README.md for how to get these via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated Instagram usernames to track (no @)
IG_USERNAMES=mynamesophiaaa,yourfavoritesophiaaa,sophiaamaryme1,itssophia.mr

# Weekday (Python %A name, e.g. Sunday/Monday/...) on which followers are
# also checked, in addition to the daily views check. Optional, defaults to
# Sunday. Kept weekly (not daily) to stay under the RapidAPI free plan's
# 150 requests/month cap.
WEEKLY_FOLLOWER_CHECK_DAY=Sunday
